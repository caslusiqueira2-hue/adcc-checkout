# ==========================================
# CONFIGURAÇÃO SIGILOPAY & CHECKOUT ADCC
# ==========================================

# 1. Chaves da SigiloPay (Obtenha em https://app.sigilopay.com.br)
SIGILOPAY_PUBLIC_KEY=SUA_CHAVE_PUBLICA_AQUI
SIGILOPAY_SECRET_KEY=SUA_CHAVE_SECRETA_AQUI

# 2. Link do Grupo VIP no Telegram (Entregue automaticamente ao confirmar o Pix)
TELEGRAM_GROUP_LINK=https://t.me/+ADCC2026_VIP_OFICIAL

# 3. Supabase (Opcional - caso queira salvar no banco Supabase conforme instrução)
# Se não preencher, o checkout continua funcionando normalmente com cache local e polling!
SUPABASE_URL=SUA_URL_SUPABASE_AQUI
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE_SUPABASE_AQUI
VITE_SUPABASE_URL=SUA_URL_SUPABASE_AQUI
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_ANON_SUPABASE_AQUI
